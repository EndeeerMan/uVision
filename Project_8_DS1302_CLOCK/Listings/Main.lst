 123          unsigned char Calculate_Day(void)
 124          {
 125   1          unsigned int y = 2000 + year;
 126   1          unsigned char code t[12] =
 127   1          {
 128   1              0, 3, 2, 5, 0, 3,
 129   1              5, 1, 4, 6, 2, 4
 130   1          };
 131   1          unsigned char w;
 132   1      
 133   1          if(mo < 3)
 134   1              y--;
 135   1      
 136   1          w = (y + y / 4 - y / 100 + y / 400 + t[mo - 1] + date) % 7;
 137   1      
 138   1          if(w == 0) return 7;
 139   1      
 140   1          return w;
 141   1      }
