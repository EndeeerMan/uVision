 104          void DS1302_ReadTime(void)
 105          {
 106   1          year_bcd = DS1302_ReadByte(0x8D);     //年
 107   1          mo_bcd = DS1302_ReadByte(0x89);       //月
 108   1          date_bcd = DS1302_ReadByte(0x87);     //日
 109   1          day_bcd = DS1302_ReadByte(0x8B);      //星期
 110   1          hour_bcd = DS1302_ReadByte(0x85);     //小时
 111   1          min_bcd = DS1302_ReadByte(0x83);      //分钟
 112   1          sec_bcd = DS1302_ReadByte(0x81);      //秒
 113   1              
 114   1          year = (year_bcd >> 4) * 10 + (year_bcd & 0x0F);
C51 COMPILER V9.56.0.0   MAIN                                                              10/02/2026 16:24:50 PAGE 3   

 115   1          mo = (mo_bcd >> 4) * 10 + (mo_bcd & 0x0F);
 116   1          date = (date_bcd >> 4) * 10 + (date_bcd & 0x0F);
 117   1          day = (day_bcd & 0x07);
 118   1          hour = ((hour_bcd & 0x30) >> 4) * 10 + (hour_bcd & 0x0F);
 119   1          min = (min_bcd >> 4) * 10 + (min_bcd & 0x0F);
 120   1          sec  = ((sec_bcd & 0x70) >> 4) * 10 + (sec_bcd & 0x0F);
 121   1      }
