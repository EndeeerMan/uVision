MACRO ASSEMBLER A51 V8.2.5.0
OBJECT MODULE PLACED IN .\Objects\Main.obj
ASSEMBLER INVOKED BY: C:\Keil_v5\C51\BIN\A51.EXE Main.a51 SET(SMALL) DEBUG PRINT(.\Listings\Main.lst) OBJECT(.\Objects\M
                      ain.obj) EP

LOC  OBJ            LINE     SOURCE

0000                   1     ORG 0000H       ; 程序起始地址

0000 020100            2     LJMP MAIN       ; 跳转到主程序

                       3     

0100                   4     ORG 0100H       ; 主程序存放地址

0100                   5     MAIN:

0100 C2A0              6         CLR P2.0    ; 将P1.0输出低电平，点亮LED

0102 12010D            7         LCALL DELAY ; 调用延时子程序

0105 D2A0              8         SETB P2.0   ; 将P1.0输出高电平，熄灭LED

0107 12010D            9         LCALL DELAY ; 调用延时子程序

010A 020100           10         LJMP MAIN   ; 循环重复

                      11     

                      12     ; 简单的延时子程序

010D                  13     DELAY:

010D 7FC8             14         MOV R7, #200

010F                  15     D1: 

010F 7EFA             16         MOV R6, #250

0111                  17     D2: 

0111 DEFE             18         DJNZ R6, D2 ; R6减1，不为0则循环

0113 DFFA             19         DJNZ R7, D1 ; R7减1，不为0则循环

0115 22               20         RET         ; 返回主程序

                      21     END             ; 汇编程序结束

