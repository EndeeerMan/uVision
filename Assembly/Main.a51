ORG 0000H
LJMP MAIN

ORG 0100H
MAIN:
    LCALL _74595HC_WRITEBYTE

    LOOP:
        
        SJMP LOOP

_74595HC_WRITEBYTE:
    MOV P0, #0000
    SETB P3.4
    CLR P3.6
    CLR P3.5 
    
    MOV R0, #0008
    
    CIR1:
        SETB P3.6   ;SCLK
        CLR P3.6
    DJNZ R0,CIR1

    SETB P3.5       ;RCLK
    CLR P3.5
    RET
END
